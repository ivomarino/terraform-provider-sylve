# Build output. bin/ is used locally with a `dev_overrides` block in
# ~/.terraformrc for testing against a real Sylve instance without
# registry publishing -- see this repo's own sylve-provider-dev-notes.md
# (kept outside this directory, not part of this provider's own history).
bin/
terraform-provider-sylve
terraform-provider-sylve.exe

# Local Terraform test scratch, if ever run from inside this repo.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
